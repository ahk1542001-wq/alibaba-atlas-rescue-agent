# Atlas Sandbox uses the official atlas-flight CLI session.
# Run: atlas-flight auth login

# Brain architecture selector (V2 strangler-fig, audit #10).
#   legacy     = the submitted deterministic TravelCare brain (default)
#   qwen_agent = experimental Qwen-Agent brain; requires requirements-v2.txt
#                AND at least one healthy provider key below. If the
#                qwen-agent package is absent, the app serves a labeled
#                legacy fallback instead of erroring.
TRAVELCARE_BRAIN=legacy

# Alibaba Cloud / Model Studio (Optional for direct API calls)
ALIBABA_MODEL_API_KEY=your_model_studio_api_key_here
DEFAULT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# OpenRouter fallback provider (used when ModelScope is unhealthy, e.g. 429).
OPENROUTER_API_KEY=

# DEMO_MODEL (optional, documented per audit #10; untracked demo folder): model override for the
# OpenRouter route ONLY, consumed by services/llm_providers.py and
# examples/qwen_agent_demo/demo_qwen_agent.py. Leave unset to use the
# pinned default qwen/qwen3-235b-a22b-2507.
# DEMO_MODEL=qwen/qwen3-235b-a22b-2507

# Application Port
PORT=8050
HOST=0.0.0.0
# Proactive Telegram Guardian (optional; live delivery requires all three values. Keep false for the sandbox demo.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LIVE_TEST=false
